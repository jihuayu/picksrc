    "vite": ">=5 <9",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@babel/traverse": "7.29.10",
    "@babel/types": "7.29.8",
    "magic-string": "0.30.21",
    "@jridgewell/trace-mapping": "0.3.31"
  },
  "peerDependenciesMeta": {
